{
  "name": "flint-ui-language-server",
  "displayName": "Flint UI Language Server",
  "description": "Language support for FlintEngine's declarative UI markup (.flml): syntax highlighting, context-aware completions, and diagnostics.",
  "version": "0.1.1",
  "author": "Manuel Osorio",
  "publisher": "FlintEngine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlintEngine/ui-language-tools.git"
  },
  "bugs": {
    "url": "https://github.com/FlintEngine/ui-language-tools/issues"
  },
  "homepage": "https://github.com/FlintEngine/ui-language-tools#readme",
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage"
  ],
  "main": "./client/out/extension",
  "contributes": {
    "languages": [
      {
        "id": "flml",
        "extensions": [
          ".flml"
        ],
        "icon": {
          "light": "./images/icon.svg",
          "dark": "./images/icon-reverse.svg"
        },
        "aliases": [
          "Flint Markup Language",
          "Flint UI"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flml",
        "scopeName": "text.flml",
        "path": "./syntaxes/flint-markup.tmLanguage.json"
      },
      {
        "scopeName": "flml.markdown.injection",
        "path": "./syntaxes/flml-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.flml": "flml"
        }
      }
    ],
    "configuration": {
      "title": "FLML",
      "properties": {
        "flml.autoClosingTags": {
          "type": "boolean",
          "default": true,
          "description": "Automatically insert closing tags after typing '>' or '</'."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "vscode:publish": "npx @vscode/vsce package",
    "compile": "tsc -b client server",
    "watch": "tsc -b -w",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd .."
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^5.9.3"
  }
}